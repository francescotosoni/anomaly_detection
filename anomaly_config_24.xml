<?xml version="1.0"?>
<rtde_config>
	<recipe key="out">
        <!-- Controller Timestamp -->
        <field name="timestamp" type="DOUBLE"/>
        <!-- Actual joint positions (6 values, rad) -->
		<field name="actual_q" type="VECTOR6D"/>
        <!-- Actual joint currents (6 values, A) -->
		<field name="actual_current" type="VECTOR6D"/>
        <!-- Actual joint velocities (6 values, rad/s) -->
		<field name="actual_qd" type="VECTOR6D"/>
        <!-- Actual TCP forces/torques (6 values, N/Nm) -->
		<field name="actual_TCP_force" type="VECTOR6D"/>
	</recipe>
</rtde_config>
