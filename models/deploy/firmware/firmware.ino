/*
 * UR5 Anomaly Detection — Firmware MCU (ESP32 / Arduino Nano 33 BLE)
 * ===================================================================
 *
 * Receives 24 ALREADY SCALED features from the Python bridge over serial, keeps 50
 * timesteps in a ring buffer, runs inference with the Edge Impulse library and
 * replies with the anomaly score in JSON.
 *
 * NB: scaling (x-mean)/std is done on the PC (bridge.py). The board does not know
 * the scaler: it only runs the model.
 *
 * Serial protocol:
 *   Input  (from the bridge):  {"f":[1.23,4.56,...24 values]}\n
 *   Output (to the bridge):    {"s":0.0031,"t":12}\n
 *                          s = anomaly score, t = inference time (ms)
 *
 * Setup:
 *   1. Board Manager: install the core for your board
 *        - Nano 33 BLE  -> "Arduino Mbed OS Nano Boards"
 *        - ESP32 / S3   -> "esp32" by Espressif
 *   2. Extract the Edge Impulse library (.zip) into Documents/Arduino/libraries/
 *   3. Update the #include line below with your library name
 *   4. Select the board and its options:
 *        - "Arduino Nano 33 BLE"  (Mbed OS Nano core)
 *        - "ESP32 Dev Module"     (classic WROOM-32)
 *        - "ESP32S3 Dev Module"   (S3) with:
 *              PSRAM            = OPI PSRAM   (8 MB, vendor AP_3v3)
 *              USB CDC On Boot  = Enabled     (Serial on the native USB)
 *              Flash Size       = 16MB (128Mb)
 *          Upload over the CH343 bridge port; data travels on the native USB.
 *   5. Upload
 *
 * The boot message reports board, frame, heap, PSRAM and clock: it exists to
 * confirm the options are right before trusting any measurement.
 *
 * No external library required beyond the Edge Impulse one.
 */

// ============================================================
// MODEL SELECTION
// ============================================================
// The Edge Impulse libraries coexist in libraries/ under distinct names: to switch
// model just uncomment the matching line. Arduino compiles ONLY the library reached
// by the #include directives, so the others stay inert (no symbol clashes).
//
//
// Edge Impulse names the library after the project, so different exports from the
// same project end up homonymous and Arduino IDE rejects one of them. To rename one
// without regenerating it:
//   python utils/rename_ei_library.py --list
//   python utils/rename_ei_library.py --lib <folder> --new-name ICE_s3_MLP
//
// REMEMBER to align `anomaly_threshold` below with the model you pick.
// ============================================================
// Static tensor arena instead of one allocated per inference. By default the SDK
// calls ei_aligned_calloc(16, 31532) + free on every invocation, and the calloc
// zeroes all 31 KB anyway. It is not the bulk of the cost, but removing it is free:
// the engine functions are `static` inside a header, so they are compiled into THIS
// translation unit and the macro takes effect from here, without touching the
// library code.
#define EI_CLASSIFIER_ALLOCATION_STATIC 1

// NB: EI_CLASSIFIER_ENABLE_PROFILER is useless in this SDK. Once enabled,
// MicroProfiler::LogCsv() prints the headers only: the body sits inside
// `#if !defined(TF_LITE_STRIP_ERROR_STRINGS)`, and micro_log.h defines that macro
// by default (unless EON_COMPILER_RUN), reducing MicroPrintf to an empty #define.
// To profile, use the "b" command below, not the SDK profiler.
// ============================================================
// #include <ICE_nano_CNN_inferencing.h>       // CNN, Nano 33 BLE  (v1) -> threshold 0.15779f
// #include <ICE_nano_MLP_inferencing.h>       // MLP, Nano 33 BLE  (v1) -> threshold 0.02942f
#include <ICE_s3_MLP_inferencing.h>            // MLP, ESP32-S3     (v2) -> threshold 0.02358f
// #include <ICE_s3_CNN_inferencing.h>         // CNN, ESP32-S3     (v2) -> threshold 0.08268f  [644 ms, see below]
//
// The CNN on this board measures 644 ms per inference against an 80 ms budget.
// It is not a hardware problem: the same MAC count in plain C inside this firmware
// takes 103 ms (13 cycles/MAC against 82), and ESP-NN is active with its S3
// kernels. The time is lost inside the Edge Impulse SDK, which among other things
// rebuilds the interpreter and calls AllocateTensors() on every inference.
//
// The MLP does 45 thousand MACs against the CNN 1.9 million, and the Edge Impulse
// benchmark puts it at 8 ms on this target. Compiling it required unblocking the
// Gather op in the SDK: `MicroMutableOpResolver::AddGather()` sits inside
// `#ifndef TF_LITE_STATIC_MEMORY`, a macro defined in the ESP32 build and not in the
// mbed one of the Nano, while the resolver generated by EI calls it regardless. Patch in
// ICE_s3_MLP_inferencing: micro_mutable_op_resolver.h, kernels/micro_ops.h,
// kernels/gather.cpp. It is lost when the library is regenerated from Edge Impulse.

// No external JSON library: the incoming message has a FIXED format
// ({"f":[24 numbers]}), so a direct strtof parser is lighter and faster than a
// generic one - and at 125 Hz the difference matters.
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

// The SDK implementation of ei_printf uses printf(), which lands on UART0: with
// "USB CDC On Boot" enabled Serial is the native USB instead, so SDK messages
// (allocation failures, incompatible model) would come out of a different port
// from the one we are reading, i.e. effectively nowhere.
// The SDK version is declared weak: redefining it here replaces it at link time
// and brings everything onto the same serial line as the protocol.
void ei_printf(const char *format, ...) {
    static char buf[512];
    va_list args;
    va_start(args, format);
    int n = vsnprintf(buf, sizeof(buf), format, args);
    va_end(args);
    if (n > 0) {
        Serial.print(buf);
    }
}

// --- Configuration ---
#define WINDOW_SIZE     50
#define N_FEATURES      24
#define FRAME_SIZE      (WINDOW_SIZE * N_FEATURES)  // 1200
#define INFERENCE_STEP  10    // Inference every N new samples

// --- Differences between boards ---
// LED: the ESP32-S3 devkit has NO plain GPIO LED but an addressable RGB one
//      (WS2812/NeoPixel): digitalWrite does not work, the core rgbLedWrite() does.
//      On the classic ESP32 the built-in LED is on GPIO2; on the Nano 33 BLE it is LED_BUILTIN.
// BAUD: virtual where native USB CDC exists (Nano 33 BLE, and S3 with "USB CDC On
//      Boot: Enabled"); it only matters where there is a real USB-UART bridge
//      (classic ESP32 via CP2102, or S3 with CDC disabled, using the CH343).
#if defined(ARDUINO_ARCH_NRF52840) || defined(ARDUINO_ARCH_MBED)
  #define LED_PIN       LED_BUILTIN
  #define LED_IS_RGB    0
  #define SERIAL_BAUD   115200        // ignored by USB CDC, kept for compatibility
  #define BOARD_NAME    "nano33ble"
#elif defined(CONFIG_IDF_TARGET_ESP32S3) || defined(ARDUINO_ESP32S3_DEV)
  // RGB_BUILTIN is defined by the core when the board declares an addressable LED
  #ifdef RGB_BUILTIN
    #define LED_PIN     RGB_BUILTIN
    #define LED_IS_RGB  1
  #else
    #define LED_PIN     48            // typical RGB LED GPIO on S3 devkits
    #define LED_IS_RGB  1
  #endif
  // Virtual with USB CDC On Boot enabled (Serial = native USB). It does matter on
  // devkits with a CH343 bridge, where Serial goes to UART0: there 115200 is NOT
  // enough, because at 125 Hz with ~123-byte messages about 154 kbaud are needed.
  #define SERIAL_BAUD   460800
  #define BOARD_NAME    "esp32s3"
#else
  #define LED_PIN       2
  #define LED_IS_RGB    0
  #define SERIAL_BAUD   460800
  #define BOARD_NAME    "esp32"
#endif


// States of the status LED:
//   LED_OFF    off     setup running, board not ready yet
//   LED_IDLE   blue    no data arriving, or window not yet full
//   LED_NORMAL green   inference running, score below threshold
//   LED_ALARM  red     score above threshold
// Green and red mirror the dashboard banner, so board and screen say the same thing.
// On boards with a single LED (Nano, classic ESP32) only on/off remains: just the
// alarm lights up.
// The values are constants rather than an enum because the Arduino IDE generates the
// prototypes of the .ino functions itself and inserts them at the top of the file,
// potentially before this declaration: a custom type in the signature of set_led()
// would give "has not been declared". With uint8_t the problem does not arise.
#define LED_OFF     0
#define LED_IDLE    1
#define LED_NORMAL  2
#define LED_ALARM   3

// Serial silence beyond which the board considers itself idle. It must stay well
// above the interval between two inferences (INFERENCE_STEP samples, ~80 ms at
// 125 Hz), otherwise the LED would blink blue during normal operation.
#define IDLE_TIMEOUT_MS 500

static uint8_t led_state = LED_OFF;
static bool led_written = false;   // il LED non è ancora stato scritto una prima volta

static void set_led(uint8_t st) {
    // Rewriting the RGB LED on every loop iteration would cost a WS2812 bit-bang
    // (~30 us) for nothing: update only on state changes.
    if (led_written && st == led_state) {
        return;
    }
    led_state = st;
    led_written = true;
#if LED_IS_RGB
    // Modest brightness: at full scale the devkit LED is unpleasant to look at.
    switch (st) {
        case LED_ALARM:  rgbLedWrite(LED_PIN, 40, 0, 0);  break;
        case LED_NORMAL: rgbLedWrite(LED_PIN, 0, 25, 0);  break;
        case LED_IDLE:   rgbLedWrite(LED_PIN, 0, 0, 25);  break;
        default:         rgbLedWrite(LED_PIN, 0, 0, 0);   break;
    }
#else
    digitalWrite(LED_PIN, st == LED_ALARM ? HIGH : LOW);
#endif
}

static inline void set_alarm_led(bool on) {
    set_led(on ? LED_ALARM : LED_NORMAL);
}

// Timestamp of the last valid sample received. `have_sample` separates "no sample
// for a while" from "no sample ever": at boot millis() is ~0, so comparing the
// timestamp alone would not detect the idle state.
static unsigned long last_sample_ms = 0;
static bool have_sample = false;

// --- Buffer circolare ---
static float ring_buffer[WINDOW_SIZE][N_FEATURES];
static int write_idx = 0;
static int total_samples = 0;
static int samples_since_inference = 0;

// --- Inference buffer (flat, in chronological order) ---
static float inference_buffer[FRAME_SIZE];

// --- Serial read buffer ---
static char serial_buffer[1024];
static int serial_pos = 0;

// --- Manual mode (PC tests only) ---
// With automatic inference enabled, every 10 samples the board blocks for ~47 ms to
// infer and during that time does NOT read the serial line: incoming samples fill
// the USB buffer and are lost. In manual mode inference happens on command only, so
// the PC can send a complete window without losses.
// In the lab the mode stays AUTOMATIC (the bridge sends no commands).
static bool manual_mode = false;

// --- Breakdown of the last inference time (microseconds) ---
// Shows WHERE the time goes: the DSP block (mean/std/max/min/RMS statistics over
// 50x19 values) or the neural network. The distinction decides whether a faster
// board is worth it: if the DSP dominates a better core helps proportionally, if
// framework overhead dominates, changing hardware buys little.
static long last_dsp_us = 0;
static long last_nn_us = 0;

// --- Threshold ---
// It MUST match the model in the Edge Impulse library currently installed:
//   MLP combinato int8 -> 0.02942f
//   CNN combinata int8 -> 0.15779f   <-- attivo ora
// The two scales are not comparable (the MLP reconstructs 95 statistics, the CNN the
// raw 1200-value window): swapping the thresholds makes the detector useless.
//
// q99 computed on held-out validation runs BY RUNNING THE QUANTISED TFLITE.
//
// Do NOT use the float32 threshold: input quantisation injects noise and, since the
// score IS the reconstruction error, normal scores inflate. With the float32
// threshold you would get extra false alarms. How much it matters depends on the
// model: on v2 the MLP needs 1.70x, the CNN only 1.04x.
//
//   ICE_nano_MLP (v1)  0.02942f       ICE_nano_CNN (v1)  0.15779f
//   ICE_s3_MLP   (v2)  0.02358f       ICE_s3_CNN   (v2)  0.08268f
//
// Mind the int8 output saturation: v1 MLP ~0.0586 / CNN ~0.1880, v2 MLP 0.02475 /
// CNN 0.11214. Beyond that value the score is clipped, so the binary decision stays
// valid but the magnitude is no longer informative.
//
// Used for the local LED; the dashboard uses its own threshold.
// Reference: models/deploy/ei_combined_v2_<model>/int8_q99_threshold.npy
// MLP combined_v2 int8 on ESP32-S3, q99.95 quantile of the error over held-out
// held-out normal runs: 0.05% false alarms per window. q99 (0.02467) let through
// object release and the home pause, slow phases where 95-99% of false alarms sit.
//
// Requires the export with the extended calibration set (--score-cap 4): with the
// old one, tuned on normals only, the int8 output reached 0.02475 and EVERY quantile
// above q99.5 landed exactly on full scale, making the threshold unusable.
static float anomaly_threshold = 0.03896f;

// --------------------------------------------------------
// Edge Impulse: callback feeding data to the classifier
// --------------------------------------------------------
int raw_feature_get_data(size_t offset, size_t length, float *out_ptr) {
    memcpy(out_ptr, inference_buffer + offset, length * sizeof(float));
    return 0;
}

// --------------------------------------------------------
// Fill the flat, ordered buffer used for inference
// --------------------------------------------------------
void prepare_inference_buffer() {
    int read_idx = write_idx;  // il più vecchio
    for (int t = 0; t < WINDOW_SIZE; t++) {
        int src = (read_idx + t) % WINDOW_SIZE;
        memcpy(&inference_buffer[t * N_FEATURES], ring_buffer[src], N_FEATURES * sizeof(float));
    }
}

// --------------------------------------------------------
// Esegui inferenza Edge Impulse
// --------------------------------------------------------
float run_inference(float *inference_time_ms) {
    prepare_inference_buffer();

    signal_t signal;
    signal.total_length = FRAME_SIZE;
    signal.get_data = &raw_feature_get_data;

    ei_impulse_result_t result = { 0 };

    unsigned long t0 = micros();
    EI_IMPULSE_ERROR err = run_classifier(&signal, &result, false /* debug */);
    unsigned long t1 = micros();

    *inference_time_ms = (t1 - t0) / 1000.0f;

    // Ripartizione riportata dal SDK (microsecondi)
    last_dsp_us = (long)result.timing.dsp_us;
    last_nn_us = (long)result.timing.classification_us;

    if (err != EI_IMPULSE_OK) {
        Serial.print("{\"err\":\"inference_failed\",\"code\":");
        Serial.print(err);
        Serial.println("}");
        return -1.0f;
    }

    // Where to read the score depends on how Edge Impulse imported the model.
    //
    // NB: EI_CLASSIFIER_HAS_ANOMALY is not a boolean, it is the anomaly detection
    // TYPE (0=none, 1=KMEANS, 2=GMM, 5=CUSTOM). Our ONNX imported via BYOM comes out
    // as EI_ANOMALY_TYPE_CUSTOM (5) with EI_CLASSIFIER_LABEL_COUNT=0, so the score
    // lives in `result.anomaly`. A `== 1` test would fail and fall through to the
    // classification branch, which does not exist here.
    //
    // `classification` is a fixed-size array of EI_CLASSIFIER_LABEL_COUNT: there is
    // no `classification_count` field.

    float score = 0.0f;

    #if EI_CLASSIFIER_LABEL_COUNT > 0
        // PREFERRED path: model imported as Regression (or Classification).
        // Postprocessing is process_classification_i8, which dequantises the int8
        // output correctly using the model scale and zero point.
        score = result.classification[0].value;
    #elif defined(EI_CLASSIFIER_HAS_ANOMALY) && (EI_CLASSIFIER_HAS_ANOMALY != 0)
        // Percorso anomaly detection nativo di EI (K-means/GMM/custom).
        #if EI_CLASSIFIER_TFLITE_OUTPUT_DATATYPE == EI_CLASSIFIER_DATATYPE_INT8
            #warning "Output int8 + modalita anomaly: process_anomaly legge la matrice \
FLOAT mentre il motore riempie quella INT8 (ei_feature_t e' una union), quindi lo score \
sara' sempre ~0. Re-importa il modello su Edge Impulse dichiarando l'output come \
REGRESSION, oppure esporta in float32."
        #endif
        score = result.anomaly;
    #else
        #error "The model exposes neither a regression/classification output nor an anomaly score"
    #endif

    return score;
}

// --------------------------------------------------------
// Parsing of a JSON line received over serial
// --------------------------------------------------------
// Control commands (used by the PC verification tool for deterministic tests):
//   {"c":"r"}  clear ring buffer and counters, and enter MANUAL mode
//   {"c":"i"}  force ONE inference now and report the score
//   {"c":"a"}  return to AUTOMATIC mode (inference every INFERENCE_STEP samples)
// Returns the command character, or 0 if the message is not a command.
char parse_command(const char *json_str) {
    const char *p = strstr(json_str, "\"c\"");
    if (p == NULL) {
        return 0;
    }
    p = strchr(p, ':');
    if (p == NULL) {
        return 0;
    }
    while (*p && (*p == ':' || *p == ' ' || *p == '"')) {
        p++;
    }
    return *p;
}


// --------------------------------------------------------
// Raw benchmark: the same 1,894,400 int8 MACs as the CNN graph, but in plain C
// inside the firmware.
//
// WHY: measured inference is 644 ms, i.e. ~82 cycles per MAC on a 240 MHz core,
// against the 5-15 expected. Static analysis does not explain the gap (ESP-NN is
// compiled, S3 assembly included, and conv.cpp selects its branch), so two
// hypotheses must be separated: "the chip is not running at the speed we think"
// against "the time is lost inside the SDK". This loop does not touch the SDK: if
// it is slow too the problem is clock/cache, if it is fast the problem is upstream.
// Two variants, because the model weights are NOT in RAM: they live in .rodata,
// i.e. in flash, read through the data cache (and here flash is in DIO mode, half
// the bandwidth of QIO). A RAM-only benchmark would not reproduce that cost, so
// comparing the two variants isolates flash access.
#define BENCH_LEN   3072
#define BENCH_MACS  1894400UL

#include "bench_flash_data.h"

static int8_t bench_a[BENCH_LEN];
static int8_t bench_b[BENCH_LEN];
static volatile int32_t bench_sink = 0;

// from_flash: if true the second operand is the .rodata array instead of the RAM one.
static uint32_t bench_mac_loop(uint32_t target_macs, bool from_flash) {
    int32_t acc = 0;
    uint32_t done = 0;
    while (done < target_macs) {
        if (from_flash) {
            for (int i = 0; i < BENCH_LEN; i++) {
                acc += (int32_t)bench_a[i] * (int32_t)bench_flash_data[i];
            }
        } else {
            for (int i = 0; i < BENCH_LEN; i++) {
                acc += (int32_t)bench_a[i] * (int32_t)bench_b[i];
            }
        }
        done += BENCH_LEN;
    }
    bench_sink = acc;   // impedisce al compilatore di eliminare il loop
    return done;
}


bool parse_features(const char *json_str, float *out_features) {
    // Formato atteso: {"f":[v0,v1,...,v23]}
    // Si cerca l'apertura dell'array e si leggono esattamente N_FEATURES numeri
    // separated by commas. Any deviation -> discard the message (the caller ignores
    // it, without corrupting the ring buffer).
    const char *p = strchr(json_str, '[');
    if (p == NULL) {
        return false;
    }
    p++;  // oltre la parentesi quadra

    for (int i = 0; i < N_FEATURES; i++) {
        char *end;
        float v = strtof(p, &end);
        if (end == p) {
            return false;   // nessuna cifra consumata: messaggio malformato
        }
        out_features[i] = v;
        p = end;
        while (*p == ' ') {
            p++;
        }
        if (i < N_FEATURES - 1) {
            if (*p != ',') {
                return false;   // separatore mancante: meno valori del previsto
            }
            p++;
        }
    }
    return true;
}

// --------------------------------------------------------
// Setup
// --------------------------------------------------------
void setup() {
    Serial.begin(SERIAL_BAUD);

#if !LED_IS_RGB
    pinMode(LED_PIN, OUTPUT);
#endif
    // Off until setup has finished: separates "booting" from "ready and waiting for
    // data" (blue), which would otherwise be indistinguishable.
    set_led(LED_OFF);

    // Initialise the buffer to zero
    memset(ring_buffer, 0, sizeof(ring_buffer));
    memset(inference_buffer, 0, sizeof(inference_buffer));

    // On native USB CDC (Nano 33 BLE) the serial line may not be ready yet.
    // BOUNDED wait: a `while (!Serial)` would block the board forever if powered
    // without a host attached.
    unsigned long t0 = millis();
    while (!Serial && (millis() - t0) < 2000) {
        delay(10);
    }
    delay(200);

    // Boot message: includes the board and the expected window size, so the PC
    // verification tool can check they match.
    Serial.print("{\"status\":\"ready\",\"board\":\"");
    Serial.print(BOARD_NAME);
    Serial.print("\",\"window\":");
    Serial.print(WINDOW_SIZE);
    Serial.print(",\"features\":");
    Serial.print(N_FEATURES);
    Serial.print(",\"frame\":");
    Serial.print(EI_CLASSIFIER_DSP_INPUT_FRAME_SIZE);
#if defined(ESP32)
    // Memory diagnostics. WARNING: PSRAM must be kept DISABLED here, so the expected
    // value is 0. The core defines CONFIG_SPIRAM_USE_MALLOC with
    // CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096, so with PSRAM enabled every
    // allocation above 4 KB ends up there - including the tensor arena (31 KB). An
    // int8 convolution is memory-bound and pays SPI latency on every access:
    // access: measured, inference goes from a few ms to 645 ms. The arena fits
    // comfortably in the ~330 KB of internal heap, PSRAM is not needed.
    Serial.print(",\"heap\":");
    Serial.print(ESP.getFreeHeap());
    Serial.print(",\"psram\":");
    Serial.print(ESP.getPsramSize());
    Serial.print(",\"cpu_mhz\":");
    Serial.print(getCpuFrequencyMhz());
    // Which accelerated kernels are REALLY active in this build. Inferring it from
    // the headers is unreliable: the macros depend on include order and on core
    // flags, so it is better to have the binary tell us.
    Serial.print(",\"esp_nn\":");
    #ifdef EI_CLASSIFIER_TFLITE_ENABLE_ESP_NN
        Serial.print(EI_CLASSIFIER_TFLITE_ENABLE_ESP_NN);
    #else
        Serial.print(-1);
    #endif
    Serial.print(",\"esp_nn_s3\":");
    #ifdef EI_CLASSIFIER_TFLITE_ENABLE_ESP_NN_S3
        Serial.print(EI_CLASSIFIER_TFLITE_ENABLE_ESP_NN_S3);
    #else
        Serial.print(-1);
    #endif
    Serial.print(",\"cmsis_nn\":");
    #ifdef EI_CLASSIFIER_TFLITE_ENABLE_CMSIS_NN
        Serial.print(EI_CLASSIFIER_TFLITE_ENABLE_CMSIS_NN);
    #else
        Serial.print(-1);
    #endif
    Serial.print(",\"arena\":");
    Serial.print(EI_CLASSIFIER_TFLITE_LARGEST_ARENA_SIZE);
#endif
    // The compiled-in threshold: without this, the only clue about what is actually
    // running was the arena, which identifies the model but not the operating point.
    // With different thresholds between float32 and int8, and between quantiles, it
    // is easy to spend half an hour testing the wrong configuration.
    Serial.print(",\"threshold\":");
    Serial.print(anomaly_threshold, 5);
    Serial.println("}");

    set_led(LED_IDLE);
}

// --------------------------------------------------------
// Loop principale
// --------------------------------------------------------
void loop() {
    // Read the serial line character by character.
    // NB: Serial.read() returns an int and can return -1 even with available()>0
    // (a race in the USB CDC driver). Assigning it to char would produce 0xFF, which
    // would enter the buffer and corrupt the message: here we break and retry later.
    while (Serial.available() > 0) {
        int ci = Serial.read();
        if (ci < 0) {
            break;
        }
        char c = (char)ci;

        if (c == '\n' || c == '\r') {
            if (serial_pos > 0) {
                serial_buffer[serial_pos] = '\0';

                // Control commands (deterministic tests from the PC)
                char cmd = parse_command(serial_buffer);
                if (cmd == 'b') {
                    for (int i = 0; i < BENCH_LEN; i++) {
                        bench_a[i] = (int8_t)(i & 0x7f);
                        bench_b[i] = (int8_t)((i * 7) & 0x7f);
                    }
                    unsigned long t0 = micros();
                    uint32_t n = bench_mac_loop(BENCH_MACS, false);
                    unsigned long dt_ram = micros() - t0;

                    t0 = micros();
                    bench_mac_loop(BENCH_MACS, true);
                    unsigned long dt_flash = micros() - t0;

                    float mhz = getCpuFrequencyMhz();
                    Serial.print("{\"bench_macs\":");
                    Serial.print(n);
                    Serial.print(",\"ram_us\":");
                    Serial.print(dt_ram);
                    Serial.print(",\"ram_cpm\":");
                    Serial.print((double)dt_ram * mhz / (double)n, 2);
                    Serial.print(",\"flash_us\":");
                    Serial.print(dt_flash);
                    Serial.print(",\"flash_cpm\":");
                    Serial.print((double)dt_flash * mhz / (double)n, 2);
                    Serial.println("}");
                    serial_pos = 0;
                    continue;
                }
                if (cmd == 'r') {
                    // Reset everything and enter manual mode: the inference counter
                    // is continuous, so without a reset a test window could be
                    // evaluated on a buffer straddling the previous one.
                    memset(ring_buffer, 0, sizeof(ring_buffer));
                    write_idx = 0;
                    total_samples = 0;
                    samples_since_inference = 0;
                    have_sample = false;
                    manual_mode = true;
                    Serial.println("{\"ok\":\"reset\",\"mode\":\"manual\"}");
                    serial_pos = 0;
                    continue;
                }
                if (cmd == 'a') {
                    manual_mode = false;
                    samples_since_inference = 0;
                    Serial.println("{\"ok\":\"auto\",\"mode\":\"auto\"}");
                    serial_pos = 0;
                    continue;
                }
                if (cmd == 'i') {
                    // Inference on demand: the PC knows exactly when the buffer
                    // holds the complete window.
                    if (total_samples < WINDOW_SIZE) {
                        Serial.print("{\"err\":\"buffer_incompleto\",\"n\":");
                        Serial.print(total_samples);
                        Serial.println("}");
                    } else {
                        float inference_ms = 0.0f;
                        float score = run_inference(&inference_ms);
                        set_alarm_led(score > anomaly_threshold);
                        Serial.print("{\"s\":");
                        Serial.print(score, 6);
                        Serial.print(",\"t\":");
                        Serial.print(inference_ms, 1);
                        Serial.print(",\"dsp_us\":");
                        Serial.print(last_dsp_us);
                        Serial.print(",\"nn_us\":");
                        Serial.print(last_nn_us);
                        Serial.println("}");
                    }
                    serial_pos = 0;
                    continue;
                }

                // Try to parse the 24 features
                float features[N_FEATURES];
                if (parse_features(serial_buffer, features)) {
                    // Store into the ring buffer
                    memcpy(ring_buffer[write_idx], features, N_FEATURES * sizeof(float));
                    write_idx = (write_idx + 1) % WINDOW_SIZE;
                    total_samples++;
                    samples_since_inference++;
                    last_sample_ms = millis();
                    have_sample = true;
                    
                    // Inference every INFERENCE_STEP samples (if the buffer is full).
                    // Suspended in manual mode: inferring here would block the serial
                    // read for ~47 ms, losing samples.
                    if (!manual_mode && total_samples >= WINDOW_SIZE
                            && samples_since_inference >= INFERENCE_STEP) {
                        samples_since_inference = 0;
                        
                        float inference_ms = 0.0f;
                        float score = run_inference(&inference_ms);
                        
                        // LED: acceso se anomalia
                        set_alarm_led(score > anomaly_threshold);
                        
                        // Reply with the score in JSON
                        Serial.print("{\"s\":");
                        Serial.print(score, 6);
                        Serial.print(",\"t\":");
                        Serial.print(inference_ms, 1);
                        Serial.print(",\"dsp_us\":");
                        Serial.print(last_dsp_us);
                        Serial.print(",\"nn_us\":");
                        Serial.print(last_nn_us);
                        Serial.println("}");
                    }

                    // In manual mode acknowledge EVERY sample with the current count:
                    // count: gives the PC flow control and makes it possible to
                    // detect (and retransmit) samples lost on the USB link.
                    if (manual_mode) {
                        Serial.print("{\"n\":");
                        Serial.print(total_samples);
                        Serial.println("}");
                    }
                } else if (manual_mode) {
                    // Malformed message (byte lost on the link): report it, so the PC
                    // can retransmit instead of ending up with an incomplete window.
                    Serial.print("{\"bad\":");
                    Serial.print(total_samples);
                    Serial.println("}");
                }

                serial_pos = 0;
            }
        } else {
            if (serial_pos < (int)(sizeof(serial_buffer) - 1)) {
                serial_buffer[serial_pos++] = c;
            } else {
                // Buffer overflow, resetta
                serial_pos = 0;
            }
        }
    }

    // Stand-by: no data arriving, or the window is not full yet and there is nothing
    // to evaluate. Outside the read loop because it must hold even when the serial
    // line is silent and the while body never runs.
    if (!have_sample || total_samples < WINDOW_SIZE
            || (millis() - last_sample_ms) > IDLE_TIMEOUT_MS) {
        set_led(LED_IDLE);
    }
}
